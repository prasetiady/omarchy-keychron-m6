#!/usr/bin/env python3
"""Talk to a Keychron M6 over its vendor HID protocol.

The Keychron Launcher calls this protocol "8k" (the family name, not the polling
rate). It runs on usage page 0xFFC1: output report 0xB3 carries 63-byte
commands, 0xB5 carries 20-byte commands, and replies come back on 0xB4/0xB6.
The receiver (Link-KM, Ultra-Link) forwards the same frames to the mouse, so
one code path covers the cable, the 2.4 GHz receiver and, when the BLE HID map
exposes the page, Bluetooth.

Output is one `key=value` per line so the bar widget can parse it with a plain
split. Every value is numeric or from a fixed vocabulary, except the UPower
model name, which is sanitized and capped.

Usage:
  keychron-ctl status
  keychron-ctl set <setting> <value>
  keychron-ctl buttons get
  keychron-ctl buttons set <index> <action> [<argument>]
  keychron-ctl restore
  keychron-ctl reset
  keychron-ctl probe

`set` and `buttons set` also save each mouse setting under
~/.local/state/keychron-m6/mouse-settings. `status` prints `drift=` with the
saved keys the mouse no longer holds, and `restore` writes those back.
"""

import errno
import fcntl
import json
import os
import re
import select
import subprocess
import sys
import time

VENDOR = 0x3434
# The widget supports only the PixArt 3311 version of the M6 (M6S-A72 and its
# colour variants), which has this product ID on the cable.
MOUSE_PID = 0xD064
VENDOR_PAGE = bytes([0x06, 0xC1, 0xFF])  # Usage Page (Vendor 0xFFC1)

REPORT_LONG = 0xB3   # 63-byte payload
REPORT_SHORT = 0xB5  # 20-byte payload
REPLY_IDS = (0xB4, 0xB6)
LONG_LEN = 63
SHORT_LEN = 20

OP_INFO = 0x02
OP_SNAPSHOT = 0x06
OP_SLEEP = 0x0A
OP_RESET = 0x0F
OP_KEY_SET = 0x52  # default layer; the Fn layer uses 0x56
OP_KEY_GET = 0x62
OP_DPI = 0x40
OP_RATE = 0x41
OP_SENSOR = 0x42
OP_DEBOUNCE = 0x43
OP_ACK = 0xE4

# Polling rate codes, as indexed by the Launcher (`rateValues`).
RATE_CODES = [125, 500, 1000, 2000, 4000, 8000, 250]

DPI_MIN = 50
DPI_MAX = 12000  # the PixArt 3311 sensor's limit
DPI_LEVELS = 5

BUS_USB = 0x0003
BUS_BLUETOOTH = 0x0005

SYSFS = os.environ.get("KEYCHRON_SYSFS", "/sys/class/hidraw")
DEVDIR = os.environ.get("KEYCHRON_DEVDIR", "/dev")
STATE_DIR = os.environ.get(
    "KEYCHRON_STATE_DIR",
    os.path.join(os.path.expanduser("~"), ".local", "state", "keychron-m6"),
)
TIMEOUT = float(os.environ.get("KEYCHRON_TIMEOUT", "1.0"))
RETRIES = 2

# Hyprland's names for the M6 pointer: on the cable, through the Link-KM
# receiver, and over Bluetooth. hypr/pointer.lua carries the same list.
DEFAULT_HYPR_NAMES = ["keychron-keychron-m6", "keychron--keychron-link-km", "keychron-m6-mouse"]
HYPR_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9:._-]{0,127}$")
HYPR_MOUSE_RE = re.compile(r"keychron.*(m6|link)")

MAX_DESCRIPTOR = 4096
MAX_UEVENT = 4096
MAX_TEXT = 65536


class AccessDenied(Exception):
    pass


class NoReply(Exception):
    pass


class Refused(Exception):
    """The mouse answered a write with an error status."""


# ---------------------------------------------------------------- discovery

class Node:
    def __init__(self, name, bus, vid, pid, kind, product=""):
        self.name = name
        self.bus = bus
        self.vid = vid
        self.pid = pid
        self.kind = kind
        self.product = product

    @property
    def path(self):
        return os.path.join(DEVDIR, self.name)


def _read(path, limit, binary=False):
    with open(path, "rb") as f:
        data = f.read(limit)
    return data if binary else data.decode("utf-8", "replace")


def parse_hid_id(uevent):
    """HID_ID=0003:00003434:0000D064 -> (bus, vendor, product)."""
    for line in uevent.splitlines():
        if line.startswith("HID_ID="):
            parts = line[7:].split(":")
            if len(parts) == 3:
                try:
                    return tuple(int(p, 16) for p in parts)
                except ValueError:
                    return None
    return None


def parse_hid_name(uevent):
    for line in uevent.splitlines():
        if line.startswith("HID_NAME="):
            return line[9:].strip()[:128]
    return ""


# Keychron ships one receiver under several product IDs (the Link-KM shows up
# as d026 or d029 depending on the port), so receivers are found by name. The
# mouse paired with a receiver is checked separately, with the bond query.
RECEIVER_NAME_RE = re.compile(r"link|receiver|dongle", re.IGNORECASE)


def classify(bus, pid, product):
    """The node's role, or None when it is neither the M6 nor a receiver."""
    if RECEIVER_NAME_RE.search(product):
        return "receiver"
    if pid != MOUSE_PID:
        return None
    return "bluetooth" if bus == BUS_BLUETOOTH else "usb"


KIND_ORDER = {"usb": 0, "receiver": 1, "bluetooth": 2}


def find_nodes(sysfs=None):
    """Keychron hidraw nodes that carry the vendor page, best path first.

    The cable wins over the receiver because only the wired path reports the
    charging bit reliably. A receiver is returned whatever mouse it is paired
    with; callers check that with `paired_with_m6` before they use it.
    """
    root = sysfs or SYSFS
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return []
    nodes = []
    for name in names:
        if not name.startswith("hidraw"):
            continue
        dev = os.path.join(root, name, "device")
        try:
            uevent = _read(os.path.join(dev, "uevent"), MAX_UEVENT)
            ident = parse_hid_id(uevent)
            desc = _read(os.path.join(dev, "report_descriptor"), MAX_DESCRIPTOR, binary=True)
        except OSError:
            continue
        if not ident:
            continue
        bus, vid, pid = ident
        if vid != VENDOR or VENDOR_PAGE not in desc:
            continue
        product = parse_hid_name(uevent)
        kind = classify(bus, pid, product)
        if kind:
            nodes.append(Node(name, bus, vid, pid, kind, product))
    nodes.sort(key=lambda n: (KIND_ORDER[n.kind], n.name))
    return nodes


def any_keychron_bluetooth(sysfs=None):
    """True when the M6 is paired over Bluetooth without the vendor page."""
    root = sysfs or SYSFS
    try:
        names = os.listdir(root)
    except OSError:
        return False
    for name in names:
        try:
            ident = parse_hid_id(_read(os.path.join(root, name, "device", "uevent"), MAX_UEVENT))
        except OSError:
            continue
        if ident == (BUS_BLUETOOTH, VENDOR, MOUSE_PID):
            return True
    return False


# ---------------------------------------------------------------- transport

class Device:
    """One open hidraw node. Commands are strictly one at a time."""

    def __init__(self, node):
        self.node = node
        try:
            self.fd = os.open(node.path, os.O_RDWR | os.O_NONBLOCK)
        except PermissionError as e:
            raise AccessDenied(node.path) from e

    def close(self):
        os.close(self.fd)

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()

    def drain(self):
        while True:
            try:
                if not os.read(self.fd, 64):
                    return
            except BlockingIOError:
                return
            except OSError:
                return

    def send(self, report_id, payload):
        size = LONG_LEN if report_id == REPORT_LONG else SHORT_LEN
        body = bytes(payload[:size]).ljust(size, b"\0")
        os.write(self.fd, bytes([report_id]) + body)

    def replies(self, timeout):
        """Yield vendor reply bodies (report id stripped) until timeout."""
        deadline = time.monotonic() + timeout
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                return
            ready, _, _ = select.select([self.fd], [], [], left)
            if not ready:
                return
            try:
                data = os.read(self.fd, 64)
            except BlockingIOError:
                continue
            except OSError as e:
                if e.errno in (errno.ENODEV, errno.EIO):
                    return
                raise
            if data and data[0] in REPLY_IDS:
                yield data[1:]

    def request(self, report_id, payload, match, timeout=None, retries=RETRIES):
        """Send a command and return the first reply that `match` accepts.

        A stale reply to an earlier command can look valid, so every caller
        matches on the echoed opcode (and the slot index where there is one).
        """
        for _ in range(retries + 1):
            self.drain()
            self.send(report_id, payload)
            for body in self.replies(timeout or TIMEOUT):
                if match(body):
                    return body
        raise NoReply(payload[0])

    def command(self, report_id, payload, timeout=None):
        """Send a write and wait for its acknowledgement (or its echo)."""
        op = payload[0]

        def acked(b):
            return (len(b) > 2 and b[0] == OP_ACK and b[2] == op) or (len(b) > 0 and b[0] == op)

        body = self.request(report_id, payload, acked, timeout=timeout)
        if body[0] == OP_ACK and body[1] not in (0, 1):
            raise Refused(op)
        return body


def lock():
    """Serialize every caller: the receiver answers one command at a time."""
    run = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    fd = os.open(os.path.join(run, "keychron-m6.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


# ---------------------------------------------------------------- protocol

def le16(b, i):
    return b[i] | (b[i + 1] << 8)


def parse_snapshot(b):
    """Decode the opcode 0x06 reply (offsets from the opcode echo).

    Layout taken from the Launcher's own parser for the "8k" protocol.
    """
    if len(b) < 62 or b[0] != OP_SNAPSHOT:
        return None
    rate_count = b[49] or 6
    rate_codes = list(b[43:49])[:rate_count]
    return {
        "profile": b[1],
        "slots": [b[2], b[3], b[4]],
        "dpi_levels": [le16(b, 5 + 2 * i) for i in range(DPI_LEVELS)],
        "sensor_byte": b[15],
        "dpi_count": b[16],
        "debounce": b[17],
        "sleep": b[18],
        "battery": b[19] & 0x7F,
        "charging": bool(b[19] & 0x80),
        "dpi_step": b[42] or 50,
        "rate_codes": rate_codes,
        "fps20k": b[52] & 1,
        "lod_byte": b[61],
    }


def parse_info(b):
    """Decode the opcode 0x02 reply: protocol version, VID/PID, work mode."""
    if len(b) < 16 or b[0] != OP_INFO:
        return None
    return {
        "pid": le16(b, 5),
        "firmware": "%d.%d.%d" % (b[8], (b[7] >> 4) & 15, b[7] & 15),
        "work_mode": b[9] & 7,
    }


def sensor_bits(byte):
    return {
        "lod": byte & 3,
        "ripple": (byte >> 2) & 1,
        "angle-snap": (byte >> 3) & 1,
        "motion-sync": (byte >> 4) & 1,
        "scroll-reverse": (byte >> 6) & 1,
    }


def rate_hz(code):
    return RATE_CODES[code] if 0 <= code < len(RATE_CODES) else None


def slot_for(snap, info):
    """The per-mode slot (low nibble DPI level, high nibble rate level)."""
    slots = snap["slots"]
    mode = info["work_mode"] if info and info["work_mode"] < 3 else None
    if mode is not None:
        return slots[mode]
    # Without the work mode, the slots agree whenever the panel wrote them,
    # because every DPI and rate write sets all three to the same level.
    return slots[0]


OP_BOND = 0x03
BOND_SLOTS = 3


def paired_with_m6(dev):
    """True when a receiver's bond list holds the supported M6.

    The reply lists up to three slots of five bytes after the opcode and a
    count: VID and PID (little-endian) and a link-state byte. The receiver
    answers this from its own memory, so it works while the mouse sleeps.
    """
    try:
        b = dev.request(REPORT_SHORT, [OP_BOND], lambda r: len(r) > 6 and r[0] == OP_BOND, retries=1)
    except NoReply:
        return False
    for i in range(BOND_SLOTS):
        off = 2 + 5 * i
        if off + 4 < len(b) and le16(b, off) == VENDOR and le16(b, off + 2) == MOUSE_PID:
            return True
    return False


def get_snapshot(dev):
    body = dev.request(REPORT_LONG, [OP_SNAPSHOT], lambda b: len(b) > 0 and b[0] == OP_SNAPSHOT)
    snap = parse_snapshot(body)
    if not snap:
        raise NoReply(OP_SNAPSHOT)
    return snap


def get_info(dev):
    try:
        body = dev.request(REPORT_SHORT, [OP_INFO], lambda b: len(b) > 0 and b[0] == OP_INFO, retries=0)
    except NoReply:
        return None
    return parse_info(body)


# ---------------------------------------------------------------- state files

def state_path(name):
    return os.path.join(STATE_DIR, name)


# Pointer settings that Hyprland applies, not the mouse. Each one is a single
# word in its own file under STATE_DIR; hypr/pointer.lua reads them as data.
HYPR_FILES = {"accel": "accel-profile", "scroll-speed": "scroll-factor"}
SCROLL_MIN = 0.1
SCROLL_MAX = 3.0


def parse_hypr(key, value):
    """Validate a Hyprland pointer setting; return the word to store."""
    if value == "default":
        return value
    if key == "accel":
        if value not in ("flat", "adaptive"):
            raise SystemExit("keychron-ctl: accel must be flat, adaptive or default")
        return value
    try:
        factor = float(value)
    except ValueError:
        factor = -1.0
    if not SCROLL_MIN <= factor <= SCROLL_MAX:
        raise SystemExit("keychron-ctl: scroll-speed must be %.1f..%.1f or default" % (SCROLL_MIN, SCROLL_MAX))
    return "%.2f" % factor


def read_hypr(key):
    try:
        word = _read(state_path(HYPR_FILES[key]), 32).strip()
        return parse_hypr(key, word)
    except (OSError, SystemExit):
        return "default"


def hypr_mouse_names():
    try:
        out = subprocess.run(
            ["hyprctl", "devices", "-j"], capture_output=True, timeout=5, check=False
        ).stdout[:MAX_TEXT * 4]
        mice = json.loads(out.decode("utf-8", "replace")).get("mice", [])
    except (OSError, ValueError, subprocess.SubprocessError, AttributeError):
        return []
    names = []
    for m in mice[:64]:
        name = str(m.get("name", "")) if isinstance(m, dict) else ""
        if HYPR_NAME_RE.match(name) and HYPR_MOUSE_RE.search(name) and "keyboard" not in name:
            names.append(name)
    return names


def write_hypr(changes):
    """Store validated pointer settings, then reload Hyprland once."""
    os.makedirs(STATE_DIR, exist_ok=True)
    for key, value in changes.items():
        path = state_path(HYPR_FILES[key])
        if value == "default":
            try:
                os.remove(path)
            except FileNotFoundError:
                pass
            continue
        names = []
        try:
            names = _read(state_path("device-names"), 8192).split()
        except OSError:
            pass
        for n in DEFAULT_HYPR_NAMES + hypr_mouse_names():
            if HYPR_NAME_RE.match(n) and n not in names:
                names.append(n)
        _atomic_write(state_path("device-names"), "\n".join(names[:32]) + "\n")
        _atomic_write(path, value + "\n")
    subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10, check=False)


def _atomic_write(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


# Mouse settings the widget wrote, kept so `restore` can write them again when
# the mouse comes back without them. The firmware keeps the snapshot settings
# across power loss, but a button mapping (and so the thumb wheel speed) can
# fall back to the factory value. One `key value` line each, validated on read.
SAVED_FILE = "mouse-settings"
# dpi-active is left out: the DPI button on the mouse changes it.
SAVED_KEYS = ("dpi-levels", "rate", "ripple", "angle-snap", "motion-sync",
              "scroll-reverse", "debounce", "sleep", "hscroll")
SAVED_MAX = 4096


def read_saved():
    """The saved settings as {key: text}; unknown or invalid lines are dropped."""
    try:
        text = _read(state_path(SAVED_FILE), SAVED_MAX)
    except OSError:
        return {}
    saved = {}
    for line in text.splitlines()[:64]:
        key, _, value = line.strip().partition(" ")
        try:
            if key in SAVED_KEYS:
                parse_setting(key, value)
            elif key.startswith("button-"):
                index = parse_int(key[7:], 0, 31, "button index")
                action, _, arg = value.partition(" ")
                if index not in BUTTON_INDEXES:
                    continue
                encode_action(action, arg)
            else:
                continue
        except SystemExit:
            continue
        saved[key] = value
    return saved


def update_saved(changes):
    """Merge {key: text or None} into the saved settings; None removes a key."""
    saved = read_saved()
    for key, value in changes.items():
        if value is None:
            saved.pop(key, None)
        else:
            saved[key] = value
    os.makedirs(STATE_DIR, exist_ok=True)
    _atomic_write(state_path(SAVED_FILE), "".join("%s %s\n" % kv for kv in sorted(saved.items())))


def saved_text(key, value):
    """A parsed setting value in the form the saved file and `set` take."""
    if isinstance(value, (list, tuple)):
        return ",".join(str(v) for v in value)
    return str(value)


# ---------------------------------------------------------------- UPower (Bluetooth)

def upower_battery():
    """Battery of a Bluetooth-paired M6 as UPower sees it, or None."""
    try:
        paths = subprocess.run(
            ["upower", "-e"], capture_output=True, timeout=5, check=False
        ).stdout.decode("utf-8", "replace")[:MAX_TEXT]
    except (OSError, subprocess.SubprocessError):
        return None
    for path in paths.splitlines()[:64]:
        if "mouse" not in path and "keychron" not in path.lower():
            continue
        try:
            info = subprocess.run(
                ["upower", "-i", path.strip()], capture_output=True, timeout=5, check=False
            ).stdout.decode("utf-8", "replace")[:MAX_TEXT]
        except (OSError, subprocess.SubprocessError):
            continue
        model = re.search(r"model:\s+(.+)", info)
        pct = re.search(r"percentage:\s+(\d+)%", info)
        state = re.search(r"state:\s+([a-z-]+)", info)
        if not model or not pct or "m6" not in model.group(1).lower():
            continue
        return {
            "battery": max(0, min(100, int(pct.group(1)))),
            "charging": bool(state and state.group(1) in ("charging", "fully-charged")),
        }
    return None


# ---------------------------------------------------------------- commands

def emit(pairs):
    for k, v in pairs:
        if isinstance(v, bool):
            v = "true" if v else "false"
        elif isinstance(v, (list, tuple)):
            v = ",".join(str(x) for x in v)
        print("%s=%s" % (k, v))


def snapshot_pairs(snap, info):
    slot = slot_for(snap, info)
    dpi_active = slot & 15
    rate_level = (slot >> 4) & 15
    codes = snap["rate_codes"]
    rate = rate_hz(codes[rate_level]) if rate_level < len(codes) else None
    sensor = sensor_bits(snap["sensor_byte"])
    pairs = [
        ("battery", snap["battery"]),
        ("charging", snap["charging"]),
        ("profile", snap["profile"]),
        ("dpi-levels", snap["dpi_levels"]),
        ("dpi-count", snap["dpi_count"]),
        ("dpi-active", dpi_active),
        ("dpi-max", DPI_MAX),
        ("dpi-step", snap["dpi_step"]),
        ("rate", rate if rate else ""),
        ("rate-options", [rate_hz(c) for c in codes if rate_hz(c)]),
        ("ripple", sensor["ripple"]),
        ("angle-snap", sensor["angle-snap"]),
        ("motion-sync", sensor["motion-sync"]),
        ("scroll-reverse", sensor["scroll-reverse"]),
        ("debounce", snap["debounce"]),
        ("sleep", snap["sleep"]),
    ]
    if info:
        pairs += [("firmware", info["firmware"]), ("work-mode", info["work_mode"])]
    return pairs


def cmd_status():
    pairs = [("accel", read_hypr("accel")), ("scroll-speed", read_hypr("scroll-speed"))]
    nodes = find_nodes()
    denied = False
    asleep = None
    for node in nodes:
        try:
            with Device(node) as dev:
                if node.kind == "receiver" and not paired_with_m6(dev):
                    continue
                try:
                    snap = get_snapshot(dev)
                except NoReply:
                    # A paired receiver whose mouse does not answer means the
                    # mouse is asleep, out of range, or on another connection.
                    # Keep looking: it may be on Bluetooth.
                    if node.kind == "receiver" and asleep is None:
                        asleep = node
                    continue
                info = get_info(dev)
                try:
                    step = read_hscroll(dev)
                    # None means the thumb wheel is remapped to another action.
                    extra = [("hscroll", step if step is not None else "custom")]
                    extra.append(("drift", drifted(dev, snap, info, read_saved(), step)))
                except NoReply:
                    extra = []
        except AccessDenied:
            denied = True
            continue
        except OSError:
            continue
        emit([("present", True), ("access", "ok"), ("connection", node.kind), ("link", "ok"),
              ("settings", True)] + snapshot_pairs(snap, info) + extra + pairs)
        return 0

    if any_keychron_bluetooth():
        bat = upower_battery()
        out = [("present", True), ("access", "denied" if denied else "ok"),
               ("connection", "bluetooth"), ("link", "ok"), ("settings", False)]
        if bat:
            out += [("battery", bat["battery"]), ("charging", bat["charging"])]
        emit(out + pairs)
        return 0

    if asleep:
        emit([("present", True), ("access", "ok"), ("connection", asleep.kind),
              ("link", "asleep")] + pairs)
        return 0

    emit([("present", False), ("access", "denied" if denied else "ok")] + pairs)
    return 0


def open_mouse():
    """First node whose mouse answers a snapshot, as (Device, snapshot)."""
    denied = False
    for node in find_nodes():
        try:
            dev = Device(node)
        except AccessDenied:
            denied = True
            continue
        try:
            if node.kind != "receiver" or paired_with_m6(dev):
                return dev, get_snapshot(dev)
        except (NoReply, OSError):
            pass
        dev.close()
    if denied:
        raise AccessDenied("no permission on the Keychron hidraw node")
    raise NoReply(OP_SNAPSHOT)


def parse_int(value, lo, hi, name):
    try:
        n = int(value, 10)
    except ValueError:
        raise SystemExit("keychron-ctl: %s must be a number" % name)
    if not lo <= n <= hi:
        raise SystemExit("keychron-ctl: %s must be %d..%d" % (name, lo, hi))
    return n


def snap_dpi(n, step=50):
    n = int(round(n / step)) * step
    return max(DPI_MIN, min(DPI_MAX, n))


def dpi_payload(level, levels, count):
    p = [OP_DPI, level, level, level]
    for v in levels:
        p += [v & 0xFF, (v >> 8) & 0xFF]
    p.append(count)
    return p


def rate_payload(level, codes):
    p = [OP_RATE, level, level] + (list(codes) + [0] * 6)[:6] + [len(codes)]
    return p


def sensor_payload(snap, overrides):
    bits = sensor_bits(snap["sensor_byte"])
    bits.update(overrides)
    on_off = lambda v: 1 if v else 2  # noqa: E731 - the protocol's on/off encoding
    p = [0] * 12
    p[0] = OP_SENSOR
    p[1] = bits["lod"]
    p[2] = on_off(bits["ripple"])
    p[3] = on_off(bits["angle-snap"])
    p[4] = on_off(bits["motion-sync"])
    p[6] = bits["scroll-reverse"] + 1
    p[8] = snap["fps20k"] + 1
    p[11] = snap["lod_byte"] & 15
    return p


SENSOR_KEYS = ("ripple", "angle-snap", "motion-sync", "scroll-reverse")
ON_OFF = {"on": 1, "true": 1, "1": 1, "off": 0, "false": 0, "0": 0}
READBACK_TRIES = 4


def parse_setting(key, value):
    """Validate a mouse setting without the mouse; return the value to store."""
    if key == "dpi-active":
        return parse_int(value, 0, DPI_LEVELS - 1, key)
    if key == "dpi":
        return snap_dpi(parse_int(value, DPI_MIN, DPI_MAX, key))
    if key == "dpi-levels":
        parts = value.split(",")
        if len(parts) != DPI_LEVELS:
            raise SystemExit("keychron-ctl: dpi-levels needs %d values" % DPI_LEVELS)
        return [snap_dpi(parse_int(p.strip(), DPI_MIN, DPI_MAX, "dpi")) for p in parts]
    if key == "rate":
        hz = parse_int(value, 1, 8000, key)
        if hz not in RATE_CODES:
            raise SystemExit("keychron-ctl: rate must be 125, 500 or 1000")
        return hz
    if key in SENSOR_KEYS:
        if value not in ON_OFF:
            raise SystemExit("keychron-ctl: %s must be on or off" % key)
        return ON_OFF[value]
    if key == "debounce":
        return parse_int(value, 0, 30, key)
    if key == "sleep":
        return parse_int(value, 1, 240, key)
    if key == "hscroll":
        return parse_int(value, 1, HSCROLL_MAX, key)
    raise SystemExit("keychron-ctl: unknown setting %r" % key)


def stored_setting(key, snap, info):
    """The value of `key` as the mouse reports it in a snapshot."""
    slot = slot_for(snap, info)
    if key == "dpi-active":
        return slot & 15
    if key == "dpi":
        return snap["dpi_levels"][slot & 15]
    if key == "dpi-levels":
        return snap["dpi_levels"]
    if key == "rate":
        codes = snap["rate_codes"]
        level = (slot >> 4) & 15
        return rate_hz(codes[level]) if level < len(codes) else None
    if key in SENSOR_KEYS:
        return sensor_bits(snap["sensor_byte"])[key]
    return snap[key]  # debounce, sleep


def setting_payload(key, want, snap, info):
    level = slot_for(snap, info) & 15
    levels = list(snap["dpi_levels"])
    count = snap["dpi_count"] or DPI_LEVELS
    if key == "dpi-active":
        if want >= count:
            raise SystemExit("keychron-ctl: dpi-active must be 0..%d" % (count - 1))
        return dpi_payload(want, levels, count)
    if key == "dpi":
        levels[level] = want
        return dpi_payload(level, levels, count)
    if key == "dpi-levels":
        return dpi_payload(level, want, count)
    if key == "rate":
        codes = snap["rate_codes"]
        if RATE_CODES.index(want) not in codes:
            raise SystemExit("keychron-ctl: rate must be one of %s" %
                             ", ".join(str(rate_hz(c)) for c in codes if rate_hz(c)))
        return rate_payload(codes.index(RATE_CODES.index(want)), codes)
    if key in SENSOR_KEYS:
        return sensor_payload(snap, {key: want})
    if key == "debounce":
        return [OP_DEBOUNCE, want]
    return [OP_SLEEP, 1, want]


def apply_setting(dev, key, want, snap, info):
    """Write one mouse setting and read it back; return (stored value, snapshot)."""
    if key == "hscroll":
        write_hscroll(dev, want)
        return read_hscroll(dev), snap
    dev.command(REPORT_SHORT, setting_payload(key, want, snap, info))
    # Read back: the panel and scripts must see what the mouse stored. The
    # receiver forwards a write a little later, so give it a few tries.
    for _ in range(READBACK_TRIES):
        snap = get_snapshot(dev)
        got = stored_setting(key, snap, info)
        if got == want:
            break
        time.sleep(0.1)
    return got, snap


def cmd_set(key, value):
    if key in HYPR_FILES:
        write_hypr({key: parse_hypr(key, value)})
        return 0

    want = parse_setting(key, value)
    dev, snap = open_mouse()
    with dev:
        info = get_info(dev)
        got, snap = apply_setting(dev, key, want, snap, info)
    if got != want:
        if key == "hscroll":
            print("keychron-ctl: the thumb wheel stored %s, not %s" % (got or "custom", want), file=sys.stderr)
        else:
            print("keychron-ctl: the mouse stored %s=%s, not %s" % (key, got, want), file=sys.stderr)
        return 1
    if key == "dpi":
        update_saved({"dpi-levels": saved_text(key, snap["dpi_levels"])})
    elif key == "hscroll":
        # The thumb wheel is buttons 10 and 11; one saved value owns them.
        update_saved({key: saved_text(key, want), "button-%d" % THUMB_RIGHT: None,
                      "button-%d" % THUMB_LEFT: None})
    elif key in SAVED_KEYS:
        update_saved({key: saved_text(key, want)})
    return 0


def drifted(dev, snap, info, saved, hscroll):
    """Saved keys whose value on the mouse differs from the saved one."""
    keys = []
    for key in SAVED_KEYS:
        if key not in saved:
            continue
        want = parse_setting(key, saved[key])
        got = hscroll if key == "hscroll" else stored_setting(key, snap, info)
        if got != want:
            keys.append(key)
    for key in sorted(k for k in saved if k.startswith("button-")):
        index = int(key[7:])
        action, _, arg = saved[key].partition(" ")
        if read_button(dev, index) != expected_button(action, arg):
            keys.append(key)
    return keys


def cmd_restore():
    """Write back every saved setting the mouse lost; print the keys it fixed."""
    saved = read_saved()
    if not saved:
        return 0
    dev, snap = open_mouse()
    failed = []
    with dev:
        info = get_info(dev)
        hscroll = read_hscroll(dev) if "hscroll" in saved else None
        for key in drifted(dev, snap, info, saved, hscroll):
            if key.startswith("button-"):
                action, _, arg = saved[key].partition(" ")
                ok = write_button(dev, int(key[7:]), action, arg)[0]
            else:
                want = parse_setting(key, saved[key])
                try:
                    got, snap = apply_setting(dev, key, want, snap, info)
                except SystemExit:
                    got = None  # The mouse no longer offers this value.
                ok = got == want
            print("%s=%s" % (key, "restored" if ok else "failed"))
            LOG_DETAIL.append("%s=%s" % (key, "restored" if ok else "failed"))
            if not ok:
                failed.append(key)
    return 1 if failed else 0


