# Indexes from the Launcher's definition of the M6 (vendor_product_id 875876452).
BUTTONS = [
    (1, "Middle", "Clicking the scroll wheel."),
    (2, "Right", "The right main button."),
    (3, "Back", "The rear side button, under your thumb."),
    (4, "Forward", "The front side button, under your thumb."),
    (9, "Wheel tilt left", "Pushing the scroll wheel to the left."),
    (8, "Wheel tilt right", "Pushing the scroll wheel to the right."),
    (14, "Wheel up", "Scrolling the main wheel up, one notch."),
    (13, "Wheel down", "Scrolling the main wheel down, one notch."),
    (11, "Thumb wheel left", "Turning the side thumb wheel towards the back."),
    (10, "Thumb wheel right", "Turning the side thumb wheel towards the front."),
]
# Left click (index 0) is never offered, so you cannot lock yourself out.
BUTTON_INDEXES = {b[0] for b in BUTTONS}

KIND_DEFAULT = 0
KIND_MOUSE = 1
KIND_KEYBOARD = 2
KIND_MEDIA = 3
KIND_DPI = 5
KIND_DISABLE = 9

# Mouse functions: three bytes, high to low = [buttons, wheel, horizontal wheel].
MOUSE_FUNCS = {
    "left": [0x01, 0, 0], "right": [0x02, 0, 0], "middle": [0x04, 0, 0],
    "back": [0x08, 0, 0], "forward": [0x10, 0, 0],
    "scroll-up": [0, 0x02, 0], "scroll-down": [0, 0xFE, 0],
    "scroll-left": [0, 0, 0xFE], "scroll-right": [0, 0, 0x02],
}
MEDIA_FUNCS = {
    "volume-up": 233, "volume-down": 234, "mute": 226, "play-pause": 205,
    "previous": 182, "next": 181, "stop": 183,
}
DPI_FUNCS = {"dpi-cycle": 1, "dpi-up": 2, "dpi-down": 3}

MODIFIERS = {"ctrl": 1, "shift": 2, "alt": 4, "super": 8}
# HID keyboard usage IDs for the keys a shortcut can end in.
KEYCODES = {}
for _i, _c in enumerate("abcdefghijklmnopqrstuvwxyz"):
    KEYCODES[_c] = 4 + _i
for _i, _c in enumerate("1234567890"):
    KEYCODES[_c] = 30 + _i
for _i in range(1, 13):
    KEYCODES["f%d" % _i] = 57 + _i
for _i in range(13, 25):
    KEYCODES["f%d" % _i] = 104 + (_i - 13)
KEYCODES.update({
    "enter": 40, "escape": 41, "backspace": 42, "tab": 43, "space": 44,
    "minus": 45, "equal": 46, "bracketleft": 47, "bracketright": 48,
    "backslash": 49, "semicolon": 51, "apostrophe": 52, "grave": 53,
    "comma": 54, "period": 55, "slash": 56, "print": 70, "pause": 72,
    "insert": 73, "home": 74, "pageup": 75, "delete": 76, "end": 77,
    "pagedown": 78, "right": 79, "left": 80, "down": 81, "up": 82,
})
KEYNAMES = {v: k for k, v in KEYCODES.items()}

ACTION_LABELS = [
    ("default", "Default"), ("disable", "Disabled"),
    ("left", "Left click"), ("right", "Right click"), ("middle", "Middle click"),
    ("back", "Back"), ("forward", "Forward"),
    ("scroll-up", "Scroll up"), ("scroll-down", "Scroll down"),
    ("scroll-left", "Scroll left"), ("scroll-right", "Scroll right"),
    ("volume-up", "Volume up"), ("volume-down", "Volume down"), ("mute", "Mute"),
    ("play-pause", "Play/pause"), ("previous", "Previous track"),
    ("next", "Next track"), ("stop", "Stop"),
    ("dpi-cycle", "DPI cycle"), ("dpi-up", "DPI up"), ("dpi-down", "DPI down"),
    ("shortcut", "Keyboard shortcut"),
]
ACTIONS = [{"id": i, "label": l} for i, l in ACTION_LABELS]


def parse_shortcut(text):
    """'super+shift+f13' -> [modmask, keycode]."""
    parts = [p.strip().lower() for p in text.split("+") if p.strip()]
    if not parts or len(parts) > 5:
        raise SystemExit("keychron-ctl: shortcut looks like super+shift+f13")
    mask = 0
    for p in parts[:-1]:
        if p not in MODIFIERS:
            raise SystemExit("keychron-ctl: unknown modifier %r" % p)
        mask |= MODIFIERS[p]
    if parts[-1] not in KEYCODES:
        raise SystemExit("keychron-ctl: unknown key %r" % parts[-1])
    return [mask, KEYCODES[parts[-1]]]


def format_shortcut(mask, code):
    mods = [name for name, bit in MODIFIERS.items() if mask & bit]
    return "+".join(mods + [KEYNAMES.get(code, "0x%02x" % code)])


def decode_key(kind, data):
    """A button reply's function -> (action id, argument)."""
    if kind == KIND_DEFAULT:
        return "default", ""
    if kind == KIND_DISABLE:
        return "disable", ""
    if kind == KIND_MOUSE:
        for name, b in MOUSE_FUNCS.items():
            if list(data[:3]) == b:
                return name, ""
        # A scroll action with a step size other than the named ones, such as
        # the thumb wheel speed: the argument is the step per notch.
        if data[0] == 0 and (data[1] == 0) != (data[2] == 0):
            if data[2]:
                return ("scroll-right" if data[2] < 128 else "scroll-left"), str(signed(data[2]))
            return ("scroll-up" if data[1] < 128 else "scroll-down"), str(signed(data[1]))
    if kind == KIND_MEDIA:
        code = data[0] | (data[1] << 8)
        for name, c in MEDIA_FUNCS.items():
            if c == code:
                return name, ""
    if kind == KIND_DPI:
        for name, c in DPI_FUNCS.items():
            if c == data[0]:
                return name, ""
    if kind == KIND_KEYBOARD:
        return "shortcut", format_shortcut(data[0], data[1])
    return "other", ""


def encode_action(action, arg):
    if action == "default":
        return KIND_DEFAULT, []
    if action == "disable":
        return KIND_DISABLE, []
    if action in MOUSE_FUNCS:
        return KIND_MOUSE, MOUSE_FUNCS[action]
    if action in MEDIA_FUNCS:
        c = MEDIA_FUNCS[action]
        return KIND_MEDIA, [c & 0xFF, (c >> 8) & 0xFF]
    if action in DPI_FUNCS:
        return KIND_DPI, [DPI_FUNCS[action], 0]
    if action == "shortcut":
        return KIND_KEYBOARD, parse_shortcut(arg or "")
    raise SystemExit("keychron-ctl: unknown action %r" % action)


def read_button(dev, index):
    body = dev.request(
        REPORT_LONG, [OP_KEY_GET, index],
        lambda b: len(b) > 4 and b[0] == OP_KEY_GET and b[1] == index,
    )
    return decode_key(body[3], body[4:])


def signed(byte):
    return abs(byte - 256 if byte > 127 else byte)


# The thumb wheel is two buttons. Their default sends one horizontal step per
# notch; a mouse action with a larger step makes it faster. The firmware takes
# any step from 1 to 127 (checked on an M6S-A72: step 4 sends +-4 per report).
THUMB_RIGHT = 10
THUMB_LEFT = 11
HSCROLL_MAX = 10


def read_hscroll(dev):
    """The thumb wheel's step per notch, or None when it is remapped."""
    steps = []
    for index, positive in ((THUMB_RIGHT, True), (THUMB_LEFT, False)):
        body = dev.request(
            REPORT_LONG, [OP_KEY_GET, index],
            lambda b, index=index: len(b) > 6 and b[0] == OP_KEY_GET and b[1] == index,
        )
        kind, data = body[3], body[4:7]
        if kind == KIND_DEFAULT:
            steps.append(1)
        elif kind == KIND_MOUSE and data[0] == 0 and data[1] == 0 and data[2]:
            if (data[2] < 128) != positive:
                return None
            steps.append(signed(data[2]))
        else:
            return None
    return steps[0] if steps[0] == steps[1] else None


def write_hscroll(dev, step):
    """Set both thumb wheel buttons; step 1 restores the factory mapping."""
    for index, sign in ((THUMB_RIGHT, 1), (THUMB_LEFT, -1)):
        if step == 1:
            dev.command(REPORT_LONG, [OP_KEY_SET, index, 0, KIND_DEFAULT])
        else:
            dev.command(REPORT_LONG, [OP_KEY_SET, index, 0, KIND_MOUSE, 0, 0, (sign * step) & 0xFF])


def cmd_buttons_get():
    out = {"buttons": [], "actions": ACTIONS}
    try:
        dev, _ = open_mouse()
    except (NoReply, AccessDenied, OSError):
        print(json.dumps(out))
        return 0
    with dev:
        for index, name, help_text in BUTTONS:
            try:
                action, arg = read_button(dev, index)
            except NoReply:
                action, arg = "unknown", ""
            out["buttons"].append({"index": index, "name": name, "help": help_text,
                                   "action": action, "argument": arg})
    print(json.dumps(out))
    return 0


def cmd_buttons_set(index, action, arg):
    index = parse_int(index, 0, 31, "button index")
    if index not in BUTTON_INDEXES:
        raise SystemExit("keychron-ctl: button %d cannot be remapped" % index)
    encode_action(action, arg)
    dev, _ = open_mouse()
    with dev:
        ok, (got, got_arg) = write_button(dev, index, action, arg)
    if not ok:
        want, want_arg = expected_button(action, arg)
        print("keychron-ctl: the mouse stored %s %s, not %s %s" % (got, got_arg, want, want_arg),
              file=sys.stderr)
        return 1
    changes = {"button-%d" % index: None if action == "default" else
               ("%s %s" % (action, got_arg) if got_arg else action)}
    if index in (THUMB_RIGHT, THUMB_LEFT):
        changes["hscroll"] = None  # The thumb wheel now has its own mapping.
    update_saved(changes)
    return 0


def expected_button(action, arg):
    """What read_button returns once `action` is stored."""
    kind, data = encode_action(action, arg)
    if action == "default":
        return "default", ""
    return action, format_shortcut(*data) if action == "shortcut" else ""


def write_button(dev, index, action, arg):
    """Store one button mapping and read it back; return (kept, what it read)."""
    kind, data = encode_action(action, arg)
    dev.command(REPORT_LONG, [OP_KEY_SET, index, 0, kind] + data)
    got = read_button(dev, index)
    return got == expected_button(action, arg) or (action == "default" and got[0] == "other"), got


def cmd_reset():
    dev, _ = open_mouse()
    with dev:
        dev.command(REPORT_SHORT, [OP_RESET, 0xFF], timeout=3.0)
    try:
        os.remove(state_path(SAVED_FILE))
    except FileNotFoundError:
        pass
    try:
        write_hypr({key: "default" for key in HYPR_FILES})
    except (OSError, subprocess.SubprocessError):
        pass
    return 0


# ---------------------------------------------------------------- probe

def hexdump(b):
    return " ".join("%02x" % x for x in b)


def cmd_probe():
    nodes = find_nodes()
    if not nodes:
        print("no Keychron hidraw node with usage page 0xFFC1")
        print("bluetooth node without vendor page: %s" % any_keychron_bluetooth())
        print("upower: %s" % upower_battery())
        return 1
    for node in nodes:
        print("== %s bus=%04x vid=%04x pid=%04x kind=%s" % (
            node.name, node.bus, node.vid, node.pid, node.kind))
        try:
            dev = Device(node)
        except AccessDenied:
            print("   access denied: install 70-keychron-m6.rules")
            continue
        with dev:
            probes = [
                ("info 0xB5/02", REPORT_SHORT, [OP_INFO], OP_INFO),
                ("bond 0xB5/03", REPORT_SHORT, [OP_BOND], OP_BOND),
                ("snapshot 0xB3/06", REPORT_LONG, [OP_SNAPSHOT], OP_SNAPSHOT),
                ("sleep 0xB5/0A get", REPORT_SHORT, [OP_SLEEP, 2], OP_SLEEP),
            ]
            for idx, _, _ in BUTTONS[:3]:
                probes.append(("key %d 0xB3/62" % idx, REPORT_LONG, [OP_KEY_GET, idx], OP_KEY_GET))
            for label, rid, payload, op in probes:
                try:
                    body = dev.request(rid, payload, lambda b, op=op: len(b) > 0 and b[0] == op, retries=1)
                    print("   %-18s %s" % (label, hexdump(body)))
                except NoReply:
                    print("   %-18s (no reply)" % label)
            try:
                snap = get_snapshot(dev)
                info = get_info(dev)
                for k, v in snapshot_pairs(snap, info):
                    print("   %s=%s" % (k, ",".join(map(str, v)) if isinstance(v, list) else v))
            except NoReply:
                pass
    return 0


# Every command that writes to the mouse, with its exit code, so a setting
# that changed by surprise can be traced to a write or ruled out.
LOG_FILE = "writes.log"
LOG_MAX = 32768
WRITE_COMMANDS = ("set", "buttons set", "restore", "reset")
# What a command did beyond its arguments, such as the keys restore wrote.
LOG_DETAIL = []


def log_write(argv, code):
    line = "%s %s exit=%s\n" % (time.strftime("%Y-%m-%dT%H:%M:%S"),
                                 " ".join([a[:64] for a in argv[1:6]] + LOG_DETAIL), code)
    path = state_path(LOG_FILE)
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        try:
            old = _read(path, LOG_MAX)
        except OSError:
            old = ""
        if len(old) + len(line) > LOG_MAX:
            old = old[len(old) // 2:].partition("\n")[2]
        _atomic_write(path, old + line)
    except OSError:
        pass


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    lockfd = lock()
    code = 2
    try:
        code = dispatch(argv, cmd)
        return code
    except SystemExit as e:
        code = e.code
        raise
    finally:
        if cmd in WRITE_COMMANDS or " ".join(argv[1:3]) in WRITE_COMMANDS:
            log_write(argv, code)
        os.close(lockfd)


def dispatch(argv, cmd):
    try:
        if cmd == "status":
            return cmd_status()
        if cmd == "set" and len(argv) == 4:
            return cmd_set(argv[2], argv[3])
        if cmd == "buttons" and len(argv) == 3 and argv[2] == "get":
            return cmd_buttons_get()
        if cmd == "buttons" and len(argv) in (5, 6) and argv[2] == "set":
            return cmd_buttons_set(argv[3], argv[4], argv[5] if len(argv) == 6 else "")
        if cmd == "restore":
            return cmd_restore()
        if cmd == "reset":
            return cmd_reset()
        if cmd == "probe":
            return cmd_probe()
        print(__doc__.strip(), file=sys.stderr)
        return 2
    except AccessDenied:
        print("keychron-ctl: no access to the mouse; install 70-keychron-m6.rules", file=sys.stderr)
        return 3
    except NoReply:
        print("keychron-ctl: the mouse did not answer; move it to wake it", file=sys.stderr)
        return 4
    except Refused:
        print("keychron-ctl: the mouse refused the write", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
